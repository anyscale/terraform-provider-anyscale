# Base variables for the aws-vm example.
#
# The variables below have no default and must be supplied - copy this file
# to terraform.tfvars (already gitignored) and fill in your own values, or
# pass -var-file=terraform.tfvars.example directly:
#
#   terraform apply -var-file=terraform.tfvars.example
#
# Everything else in variables.tf has a working default and does not need to
# be set here.

aws_region                   = "us-west-2"
customer_ingress_cidr_ranges = "203.0.113.0/24"                 # replace with your own CIDR
anyscale_org_id              = "org_00000000000000000000000000" # replace with your org ID
anyscale_external_id         = "my-anyscale-external-id"        # your own choice of string
